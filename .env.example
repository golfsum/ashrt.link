# Copy to ".env" and fill in.

# Port the server listens on (local dev only; ignored on Vercel).
PORT=4000

# Public base of the service. In production set this to your canonical domain so
# short links and OAuth redirect URIs read as https://www.ashrt.link/...
BASE_URL=https://www.ashrt.link

# Secret used to sign login session cookies. Use a long random string.
# If unset it falls back to API_KEY. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional legacy/admin key. Per-user API keys (from each account's page) are the
# normal way to authenticate the API now; this is no longer required.
API_KEY=

# --- Admin access ------------------------------------------------------------
# Comma-separated emails that are granted the admin role the first time they
# sign in. This is a BOOTSTRAP only: the role is then written to the user record
# and every admin check reads that, server-side. Once your account has the role
# you can clear this. Never read in the browser.
#   ADMIN_EMAILS=you@yourdomain.com
ADMIN_EMAILS=

# --- Social login (optional) -------------------------------------------------
# Leave a provider's pair blank to hide its button. Redirect/callback URLs:
#   Google:  {BASE_URL}/auth/google/callback
#   GitHub:  {BASE_URL}/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing (optional, for paid plans) --------------------------------------
# Leave blank to ship free-only; upgrade buttons show "coming soon".
# Create two recurring (subscription) Prices in Stripe and paste their ids:
#   Pro $9/mo      -> STRIPE_PRICE_PRO
#   Business $29/mo-> STRIPE_PRICE_BUSINESS
# Webhook endpoint to register in Stripe: {BASE_URL}/api/billing/webhook
# (subscribe to checkout.session.completed + customer.subscription.updated/deleted)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID is still read as a fallback for Pro if STRIPE_PRICE_PRO is unset.
STRIPE_PRICE_ID=

# --- Storage -----------------------------------------------------------------
# Leave blank for local dev (JSON files: .links.json + .users.json).
# On Vercel, add a KV / Upstash store and these are injected automatically, so
# links and accounts persist across serverless invocations (required there).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Local data directory (optional) -----------------------------------------
# Where the file backend writes its JSON when KV is not configured. Defaults to
# the repo root. The test suite points this at a temp directory so it never
# touches your local links.
ASHRT_DATA_DIR=

# --- Custom domains ----------------------------------------------------------
# Branded short links on a customer's own host (links.theirbrand.com).
#
# The feature ships ON. Set CUSTOM_DOMAINS=0 to turn it off for a deployment
# that cannot serve branded hosts at all.
CUSTOM_DOMAINS=

# Where customers point their DNS. Defaults suit a Vercel deployment; change
# them if the hosting changes, rather than editing the setup instructions.
DOMAIN_CNAME_TARGET=
DOMAIN_A_TARGET=

# Optional, and worth setting: with these the app attaches a verified domain to
# the project itself and reads back its certificate state, so a customer's
# domain goes live without anyone doing anything by hand. Without them
# everything still works, but a verified domain waits in "needs attaching"
# until someone adds it in the hosting dashboard.
#
# The token needs project read/write scope only. Treat it as a secret.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Destination health checks -----------------------------------------------
# The scheduler calls /api/cron/health-check to see whether link destinations
# are still answering. Vercel Cron sends this value as an Authorization bearer
# token; without it the endpoint refuses everyone, because an endpoint that
# makes outbound requests on demand is a free proxy for whoever finds it.
#
# Vercel sets CRON_SECRET for you when you add it as an environment variable.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
